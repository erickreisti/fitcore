# .env.example
#
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env — ele contém segredos reais.
# Este .env.example serve como documentação das variáveis necessárias.

# ── PostgreSQL ─────────────────────────────────
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=fitcore_dev
POSTGRES_DB=fitcore

# ── Segurança ──────────────────────────────────
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-segura-em-producao
