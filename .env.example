# .env.example
#
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env — ele contém segredos reais.
# Este .env.example serve como documentação das variáveis necessárias.

# ── PostgreSQL (Docker Compose local) ──────────────────────────────────────────
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=fitcore_dev
POSTGRES_DB=fitcore

# ── API (apps/api/.env) ────────────────────────────────────────────────────────
# URL de conexão com o banco de dados.
# Para desenvolvimento local: postgresql+asyncpg://fitcore:fitcore_dev@localhost:5432/fitcore
# Para Neon (produção/online): postgresql+asyncpg://usuario:senha@ep-nome-xyz.region.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://fitcore:fitcore_dev@localhost:5432/fitcore

# ── Clerk (Auth Provider) ──────────────────────────────────────────────────────
# Onde encontrar:
#   1. Acesse https://clerk.com e crie uma conta gratuita
#   2. Crie uma Application
#   3. Vá em "API Keys" → copie a "JWKS URL"
#
# Formato: https://<seu-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://seu-app.clerk.accounts.dev/.well-known/jwks.json
